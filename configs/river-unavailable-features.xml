<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi-only river: features that handheld_core_hardware.xml declares but
     this build does not ship. The phone stack (Telecom) and printing
     (PrintSpooler) are removed in build/make, so apps must not offer calls
     or printing. -->
<permissions>
    <unavailable-feature name="android.software.telecom" />
    <unavailable-feature name="android.software.print" />
    <!-- CompanionDeviceManager (watch pairing) is removed in build/make. -->
    <unavailable-feature name="android.software.companion_device_setup" />
    <!-- Financed-device lock. The DeviceLock APEX declares this feature itself;
         marking it unavailable keeps DeviceLockService from starting. -->
    <unavailable-feature name="android.software.device_lock" />
</permissions>
