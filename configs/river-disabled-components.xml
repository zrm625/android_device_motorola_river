<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi-only river: Settings screens that need the phone stack or the print
     spooler, both removed in build/make. Opened by intent (for example
     android.settings.APN_SETTINGS), they crash Settings because the carrier
     config or print service is missing. Wi-Fi-only Settings never links to
     them itself. -->
<config>
    <component-override package="com.android.settings">
        <component class=".Settings$MobileNetworkActivity" enabled="false" />
        <component class=".Settings$ApnSettingsActivity" enabled="false" />
        <component class=".Settings$PrintSettingsActivity" enabled="false" />
        <component class=".Settings$PrintJobSettingsActivity" enabled="false" />
    </component-override>
    <!-- DeviceLock and Health Connect stay installed (removing either APEX
         needs a frameworks/base fork), but their apps no longer wake at boot. -->
    <component-override package="com.android.devicelockcontroller">
        <component class="com.android.devicelockcontroller.receivers.CheckInBootCompletedReceiver" enabled="false" />
        <component class="com.android.devicelockcontroller.receivers.RecordBootTimestampReceiver" enabled="false" />
        <component class="com.android.devicelockcontroller.receivers.TimeChangedBroadcastReceiver" enabled="false" />
    </component-override>
    <component-override package="com.android.healthconnect.controller">
        <component class="com.android.healthconnect.controller.safetycenter.SafetySourceBroadcastReceiver" enabled="false" />
        <component class="com.android.healthconnect.controller.searchindexables.HealthConnectSearchIndexablesProvider" enabled="false" />
    </component-override>
    <!-- LineageOS anonymous usage stats: never schedule or send them, even if
         the setup wizard's "Help improve LineageOS" box is left ticked. -->
    <component-override package="org.lineageos.lineageparts">
        <component class="org.lineageos.lineageparts.lineagestats.ReportingServiceManager" enabled="false" />
        <component class="org.lineageos.lineageparts.lineagestats.ReportingService" enabled="false" />
        <component class="org.lineageos.lineageparts.lineagestats.StatsUploadJobService" enabled="false" />
    </component-override>
</config>
